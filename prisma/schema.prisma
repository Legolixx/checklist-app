generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ApiToken {
  id        String   @id @default(uuid())
  token     String
  expiresAt DateTime
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
}

model PacoteManutencao {
  id                   String      @id
  codigo               String
  chassi               String
  comissao             Float
  concessionario       String
  consultor            String
  dataInicio           DateTime
  dataEncerramento     DateTime
  modelo               String
  notaFiscalIndividual Boolean
  pacote               String
  prazo                Int
  revisoes             Int
  statusComissao       String
  valor                Float
  versao               String
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  mes                  Int
  DPSM                 String      @default("DPSM")
  dealer               BASE_DEALER @relation(fields: [codigo], references: [COD_DEALER])
}

model BASE_DEALER {
  COD_DEALER     String?            @unique
  NOME_DEALER    String?
  ESTADO         String?
  GRUPO          String?
  DIVIS_O        String?            @map("DIVISÃO")
  STATUS         String?
  GER_REG        String?
  xata_updatedat DateTime           @default(now()) @db.Timestamptz(6)
  xata_id        String             @unique(map: "_pgroll_new_Base-052025DPSMDLRREGIO_xata_id_key") @default(dbgenerated("('rec_'::text || (xata_private.xid())::text)"))
  xata_version   Int                @default(0)
  xata_createdat DateTime           @default(now()) @db.Timestamptz(6)
  pacotes        PacoteManutencao[]
}
