generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ApiToken {
  id        String   @id @default(uuid())
  token     String
  expiresAt DateTime
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
}

model PacoteManutencao {
  id                   String      @id
  codigo               String
  chassi               String
  comissao             Float
  concessionario       String
  consultor            String
  dataInicio           DateTime
  dataEncerramento     DateTime
  modelo               String
  notaFiscalIndividual Boolean
  pacote               String
  prazo                Int
  revisoes             Int
  statusComissao       String
  valor                Float
  versao               String
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  mes                  Int
  DPSM                 String      @default("DPSM")
  dealer               BASE_DEALER @relation(fields: [codigo], references: [COD_DEALER])
}

model BASE_DEALER {
  COD_DEALER     String?            @unique
  NOME_DEALER    String?
  ESTADO         String?
  GRUPO          String?
  DIVIS_O        String?            @map("DIVISÃO")
  STATUS         String?
  GER_REG        String?
  xata_updatedat DateTime           @default(now()) @db.Timestamptz(6)
  xata_id        String             @unique(map: "_pgroll_new_Base-052025DPSMDLRREGIO_xata_id_key") @default(dbgenerated("('rec_'::text || (xata_private.xid())::text)"))
  xata_version   Int                @default(0)
  xata_createdat DateTime           @default(now()) @db.Timestamptz(6)
  pacotes        PacoteManutencao[]
}

model resumo_os_por_dealer {
  id             String   @id @default(uuid())
  dealer         String   @unique
  nome           String
  total_os       Int
  retro_os_erdat Int
  retro_os_aedat Int
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @db.Timestamptz(6)
}

model GerServicoList {
  id             Int       @id
  dealerId       Int?
  dealerName     String?
  dealerCode     String?
  referenceMonth DateTime? // ex: 2024-01-01
  status         String?
  fetchedAt      DateTime  @default(now())

  // Relacionamento 1:1
  servico        GerServico?

  @@index([referenceMonth])
  @@index([dealerCode])
}

// Tabela principal (1 registro por concessionária/mês)
model GerServico {
  id                     Int      @id
  empresaId              Int
  empresaNome            String
  codFabrica             String
  data                   DateTime // mês de referência (2024-01-01T00:00:00Z)
  status                 String
  quickServiceInstalado  Boolean
  quickServiceOperando   Boolean
  dataEncerramento       DateTime?
  dataValidacao          DateTime?

  // Timestamps
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  // Relações
  list                   GerServicoList         @relation(fields: [id], references: [id])
  horarios               GerServicoHorario[]
  detalhesTecnicos       GerServicoDetalheTecnico[]
  metricas               GerServicoMetrica[]

  @@index([codFabrica])
  @@index([data])
}

// Horários de funcionamento
model GerServicoHorario {
  id                 Int         @id
  gerServicoId       Int
  gerServico         GerServico  @relation(fields: [gerServicoId], references: [id], onDelete: Cascade)
  tipo               String      // SABADO ou SEMANA
  entradaDia         String?
  saidaAlmoco        String?
  entradaAlmoco      String?
  saidaDia           String?
  horasTrabalhadas   String
  quantidadeDias     Int

  @@unique([id, gerServicoId])
}

// Detalhes por técnico
model GerServicoDetalheTecnico {
  id             Int         @id
  gerServicoId   Int
  gerServico     GerServico  @relation(fields: [gerServicoId], references: [id], onDelete: Cascade)
  tipo           String
  nomeTecnico    String
  diaSemana      Int
  diaSabado      Int
  faltaSemana    Int
  faltaSabado    Int
  vendidas       Decimal     @db.Decimal(12, 2)
  trabalhadas    Decimal     @db.Decimal(12, 2)
  disponiveis    Decimal     @db.Decimal(12, 2)
  absenteismo    Decimal     @default(0) @db.Decimal(8, 4)
  produtividade  Decimal     @db.Decimal(12, 8)
  eficiencia     Decimal     @db.Decimal(12, 8)
  utilizacao     Decimal     @db.Decimal(12, 8)

  @@unique([id, gerServicoId])
}

// Métricas (a mais importante pro dashboard!)
model GerServicoMetrica {
  id           Int         @id
  gerServicoId Int
  gerServico   GerServico  @relation(fields: [gerServicoId], references: [id], onDelete: Cascade)

  metricaId    Int
  titulo       String      // só PT-BR
  subTitulo    String?
  formato      String      // $ ou N
  realizado    Decimal     @db.Decimal(18, 4)

  // Campo derivado pra facilitar filtros no Power BI
  categoria    String?

  @@unique([id, gerServicoId])
  @@index([titulo])
  @@index([categoria])
}